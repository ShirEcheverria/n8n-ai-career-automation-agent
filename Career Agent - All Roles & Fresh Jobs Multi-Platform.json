    {
      "parameters": {
        "jsCode": "// סינון משרות שפורסמו לפני יותר מ-7 ימים או שאינן פעילות\nconst items = $input.all();\nconst now = new Date();\nconst filtered = [];\n\nfor (const item of items) {\n  const job = item.json;\n  let isFresh = true;\n  \n  if (job.job_posted_at_datetime_utc) {\n    const postedDate = new Date(job.job_posted_at_datetime_utc);\n    const diffDays = (now - postedDate) / (1000 * 60 * 60 * 24);\n    if (diffDays > 7) {\n      isFresh = false;\n    }\n  }\n  \n  if (job.job_is_remote === false && job.job_country !== 'IL') {\n    // אם זה לא בישראל או לא רמוט\n  }\n\n  if (isFresh && job.job_apply_link) {\n    filtered.push(item);\n  }\n}\n\nreturn filtered;"
      },
      "id": "02416109-8b17-49c6-85b3-f4fa7b4733d0",
      "name": "Filter Recent Jobs (Max 7 Days)",
