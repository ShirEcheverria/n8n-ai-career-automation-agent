        "jsCode": "const text = $json.output || $json.text || '';\nlet parsed = {};\ntry {\n  const cleanText = text.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleanText);\n} catch (e) {\n  parsed = { score: 0 };\n}\nreturn [{ json: { ...$json, analysis: parsed } }];"
