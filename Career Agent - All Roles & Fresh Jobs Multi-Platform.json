    {
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate this job listing for Shir Echeverria across all 5 career paths:\nCompany: {{ $json.employer_name }}\nTitle: {{ $json.job_title }}\nPublisher / Source: {{ $json.job_publisher }}\nLocation: {{ $json.job_city || $json.job_country }}\nDescription: {{ $json.job_description }}\nApply Link: {{ $json.job_apply_link }}\n\nMatch across:\n1. Junior Product Manager (APM, Junior PM, Technical PM)\n2. Junior Data Operations / AI Operations / Prompt Specialist\n3. Junior Data Analyst / Business Analyst\n4. Junior QA Engineer / Automation Tester\n5. Junior Project Manager / Tech Ops\n\nReturn strict JSON format with keys:\nscore (number 0-100), category (Product/Ops/Analyst/QA/PM), reason (string in Hebrew explaining match to CV), has_email (boolean), recruiter_email (string or empty), hook_subject (string in Hebrew), hook_body (string in Hebrew matching the category).",
        "options": {
          "systemMessage": "You are Shir Echeverria's Career Agent. She has a B.A. in Economics and Hi-Tech Sciences from Bar-Ilan University. Match candidates across all 5 categories using verified anchors: 1) Product (Mortgage Mate PRD, RICE, architecture), 2) Ops (n8n multi-agent backend, PDF extraction, AI cloud), 3) Data (Discount Bank financial planning, Dan Hotels KPI incident analysis, Python ML flight & mental health models), 4) QA/Testing (ML model validation, API testing, security profiling precision), 5) PM (cross-department shifts, incident resolution, high-volume airline ticketing at El Al). Discard senior/lead roles. If score >= 85 and recruiter email is available, compose a 4-sentence Hook email in Hebrew referencing the specific role anchor. Return valid JSON only."
        }
      },
